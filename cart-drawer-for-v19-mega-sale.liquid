    { "type": "header", "content": "Reservation countdown" },
    { "type": "range", "id": "reserve_minutes", "min": 3, "max": 20, "step": 1, "unit": "min", "label": "Reserve time", "default": 7 },
    { "type": "text", "id": "reserve_label", "label": "Reserve label", "default": "YOUR ORDER IS RESERVED FOR" },
    { "type": "textarea", "id": "reserve_sub", "label": "Reserve subtext", "default": "Due to high demand, items in your cart are only held for a limited time." },
    { "type": "text", "id": "reserve_badge", "label": "Reserve badge", "default": "You're one step closer to comfort ♡" },
    { "type": "header", "content": "Shipping protection (optional)" },
    { "type": "paragraph", "content": "Pick a product (e.g. a $2.99 Shipping Protection product) to show the toggle. Leave blank to hide it." },
    { "type": "product", "id": "protection_variant", "label": "Shipping protection product" },
    { "type": "text", "id": "protection_title", "label": "Protection title", "default": "Shipping Protection" },
    { "type": "text", "id": "protection_sub", "label": "Protection subtext", "default": "from Damage, Loss & Theft" },
    { "type": "header", "content": "Checkout" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" }
  ],
  "presets": [{ "name": "Cart drawer" }]
}
