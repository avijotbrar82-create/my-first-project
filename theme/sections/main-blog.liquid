<section class="pagetop">
  <div class="container">
    <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ blog.title }}</div>
    <h1 class="pagetitle serif">{{ blog.title }}</h1>
  </div>
</section>
<section class="blk" style="padding-top:26px">
  <div class="container">
    <div class="prodgrid" data-reveal data-stagger>
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="art">
            {%- if article.image -%}<img class="pimg" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" width="700" height="700" loading="lazy">{%- endif -%}
          </div>
          <div class="body">
            <span class="cat">{{ article.published_at | date: '%d %b %Y' }}</span>
            <h3>{{ article.title }}</h3>
            <p class="desc">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
            <div class="foot"><span class="add" style="border-color:var(--honey);color:var(--honey)">Read &#8594;</span></div>
          </div>
        </a>
      {%- else -%}
        <div class="empty-state"><h2 class="serif">No posts yet.</h2></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
