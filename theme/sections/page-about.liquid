<section class="about-hero">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1 class="serif" data-reveal>{{ section.settings.heading }}</h1>
    {%- if section.settings.lead != blank -%}<p class="about-lead" data-reveal>{{ section.settings.lead }}</p>{%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
    <div class="about-hero-img" data-reveal><img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading | strip_html }}" width="1400" height="700"></div>
  {%- else -%}
    <div class="about-hero-img" data-reveal><img src="{{ 'hero-massage-guns.webp' | asset_url }}" alt="Verta Relief recovery range" width="1402" height="1122"></div>
  {%- endif -%}
</section>

<section class="blk">
  <div class="container">
    <div class="story">
      <div data-reveal>
        {%- if section.settings.story_eyebrow != blank -%}<div class="eyebrow">{{ section.settings.story_eyebrow }}</div>{%- endif -%}
        <h2 class="serif">{{ section.settings.story_heading }}</h2>
      </div>
      <div data-reveal>{{ section.settings.story_text }}</div>
    </div>
  </div>
</section>

{%- assign diffs = section.blocks | where: 'type', 'diff' -%}
{%- if diffs.size > 0 -%}
<section class="blk reviews" style="padding-top:0">
  <div class="container">
    <div class="sechead" data-reveal>
      <div class="row"><div>
        {%- if section.settings.diffs_eyebrow != blank -%}<div class="eyebrow">{{ section.settings.diffs_eyebrow }}</div>{%- endif -%}
        <h2 class="serif">{{ section.settings.diffs_heading }}</h2>
      </div></div>
    </div>
    <div class="diffs" data-reveal data-stagger>
      {%- for block in diffs -%}
        <div class="diff" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Relief. Recovery. <em>Balance.</em>" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "At Verta Relief, we believe everyday relief shouldn't be complicated — or expensive. We design and curate recovery and wellness products that help real people move better, sit better, and feel better, one small habit at a time." },
    { "type": "image_picker", "id": "image", "label": "Hero image (defaults to packaged hero)" },
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "story_eyebrow", "label": "Eyebrow", "default": "Why we started" },
    { "type": "html", "id": "story_heading", "label": "Heading", "default": "Built for the <em>hours after.</em>" },
    { "type": "richtext", "id": "story_text", "label": "Text", "default": "<p>Most of us spend our days hunched over desks, phones and steering wheels — and our bodies pay for it. Stiff necks, tight shoulders and aching lower backs have become the norm instead of the exception. Verta Relief was built to change that.</p><p>We didn't want to sell one-size-fits-all gadgets that end up in a drawer after a week. So every product we offer is chosen and refined with one question in mind: will this actually make someone's day-to-day life more comfortable?</p>" },
    { "type": "header", "content": "Differentiators" },
    { "type": "text", "id": "diffs_eyebrow", "label": "Eyebrow", "default": "What makes us different" },
    { "type": "html", "id": "diffs_heading", "label": "Heading", "default": "Small brand, <em>serious care.</em>" }
  ],
  "blocks": [
    {
      "type": "diff",
      "name": "Differentiator",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Purpose-built, not just picked" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every item is selected for real, everyday relief — neck tension, posture, lower-back support, muscle recovery — not novelty." }
      ]
    }
  ],
  "presets": [{
    "name": "About",
    "blocks": [
      { "type": "diff", "settings": { "heading": "Purpose-built, not just picked", "text": "Every item is selected for real, everyday relief — neck tension, posture, lower-back support, muscle recovery — not novelty." } },
      { "type": "diff", "settings": { "heading": "Quality you can feel", "text": "We stand behind the materials and construction of every product, and refine our lineup based on real customer feedback." } },
      { "type": "diff", "settings": { "heading": "Support that doesn't disappear", "text": "Questions about sizing, use or your order? Our team is here to help — before and after your purchase." } },
      { "type": "diff", "settings": { "heading": "Built for real life", "text": "Quick to use, easy to bring along, and simple enough that they actually get used." } }
    ]
  }]
}
{% endschema %}
