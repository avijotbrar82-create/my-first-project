{%- liquid
  assign menu = section.settings.menu
  assign has_menu = false
  if linklists[menu].links.size > 0
    assign has_menu = true
  endif
-%}

{%- comment -%} Shared gradient def for the pulse mark {%- endcomment -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="hny" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="{{ settings.color_honey_lt | default: '#c58a3d' }}"/>
    <stop offset=".5" stop-color="{{ settings.color_honey | default: '#b0732e' }}"/>
    <stop offset="1" stop-color="{{ settings.color_honey_lt | default: '#c58a3d' }}"/>
  </linearGradient>
</defs></svg>

<header class="hdr{% unless template.name == 'index' %} solid{% endunless %}">
  <div class="container">
    <a class="brand" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ settings.logo_width | default: 150 }}" style="width:{{ settings.logo_width | default: 150 }}px;height:auto">
      {%- else -%}
        <svg class="mk" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="94" fill="#efe7d9"/>
          <circle cx="100" cy="100" r="94" fill="none" stroke="#9c6b4e" stroke-width="1.5" stroke-opacity="0.35"/>
          <path d="M34 104 H82 L92 104 L99 90 L106 104 L114 74 L123 132 L131 104 L138 104 H166" fill="none" stroke="url(#hny)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="wm">
          <span class="w">Verta <b>Fit</b></span>
          <span class="t">Relief · Recovery · Balance</span>
        </span>
      {%- endif -%}
    </a>

    <nav class="nav" role="navigation">
      <div class="links">
        {%- if has_menu -%}
          {%- for link in linklists[menu].links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
          <a href="/pages/about-us">About</a>
          <a href="/pages/contact">Contact</a>
        {%- endif -%}
      </div>

      <a class="cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H3"/></svg>
        <span class="badge"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <button class="nav-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </nav>
  </div>
</header>

{%- comment -%} Mobile drawer {%- endcomment -%}
<div class="nav-overlay" data-menu-close></div>
<aside class="nav-drawer" aria-label="Menu">
  <button class="close" type="button" data-menu-close aria-label="Close menu">&times;</button>
  {%- if has_menu -%}
    {%- for link in linklists[menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <a href="/pages/about-us">About</a>
    <a href="/pages/contact">Contact</a>
    <a href="/pages/track-order">Track order</a>
  {%- endif -%}
  <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
