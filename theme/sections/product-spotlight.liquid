{%- liquid
  assign product = all_products[section.settings.product]
-%}
<section class="blk spot" id="posture">
  <div class="container">
    <div class="grid">
      <div class="stage" data-reveal>
        <div class="halo"></div>
        {%- if product != blank and product.featured_media -%}
          <img class="pimg" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%">
        {%- elsif section.settings.image != blank -%}
          <img class="pimg" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%">
        {%- endif -%}
      </div>
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="serif">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {%- if section.blocks.size > 0 -%}
          <div class="specrow">
            {%- for block in section.blocks -%}
              <div class="s" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="cta-row" style="display:flex;gap:14px;flex-wrap:wrap">
          {%- if product != blank -%}
            <a class="btn btn-honey" href="{{ product.url }}">Add to cart — {{ product.price | money }}</a>
            <a class="btn btn-ghost" href="{{ product.url }}">Details</a>
          {%- else -%}
            <a class="btn btn-honey" href="{{ routes.all_products_collection_url }}">Shop now</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Spotlight · Recovery" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Pro percussion, <em>pocket-sized.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The Verta Fit Mini Massage Gun folds professional-grade percussive therapy into a calm, travel-ready body — six speeds, four heads, and a quiet brushless motor with an LCD read-out." }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "6" },
        { "type": "text", "id": "label", "label": "Label", "default": "Speed gears" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Product spotlight",
    "blocks": [
      { "type": "spec", "settings": { "value": "6", "label": "Speed gears" } },
      { "type": "spec", "settings": { "value": "4", "label": "Massage heads" } },
      { "type": "spec", "settings": { "value": "<45dB", "label": "Whisper quiet" } }
    ]
  }]
}
{% endschema %}
