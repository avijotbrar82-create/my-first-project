<div class="trust">
  <div class="container">
    {%- for block in section.blocks -%}
      {%- if forloop.index0 > 0 -%}<span class="dot"></span>{%- endif -%}
      <div class="t" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon, class: '' %}{{ block.settings.text }}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust row",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "star", "label": "Star" },
            { "value": "support", "label": "Support" }
          ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on every order" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Trust row",
    "blocks": [
      { "type": "item", "settings": { "icon": "shipping", "text": "Free shipping on every order" } },
      { "type": "item", "settings": { "icon": "guarantee", "text": "30-day comfort guarantee" } },
      { "type": "item", "settings": { "icon": "star", "text": "Loved by 10,000+ Australians" } }
    ]
  }]
}
{% endschema %}
