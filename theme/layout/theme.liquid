<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Fonts (self-hosted) {%- endcomment -%}
  <style>
    @font-face{font-family:'Fraunces';font-weight:500;font-style:normal;font-display:swap;src:url({{ 'fraunces-500.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Fraunces';font-weight:600;font-style:normal;font-display:swap;src:url({{ 'fraunces-600.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Fraunces';font-weight:500;font-style:italic;font-display:swap;src:url({{ 'fraunces-italic-500.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Nunito Sans';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'nunito-400.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Nunito Sans';font-weight:600;font-style:normal;font-display:swap;src:url({{ 'nunito-600.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Nunito Sans';font-weight:700;font-style:normal;font-display:swap;src:url({{ 'nunito-700.woff2' | asset_url }}) format('woff2');}
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <div class="grain" aria-hidden="true"></div>
  <div class="site">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement' %}
    {% section 'header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </div>
</body>
</html>
