<p style="color:var(--taupe);max-width:44ch;margin:0 auto 26px;line-height:1.6">
  Relief. Recovery. Balance. We're putting the finishing touches on something calm. Enter the store password to take a look.
</p>

{%- form 'storefront_password' -%}
  {%- if form.errors -%}<div class="form-error" style="max-width:360px;margin:0 auto 16px">{{ form.errors | default_errors }}</div>{%- endif -%}
  <div style="display:flex;gap:10px;max-width:420px;margin:0 auto;flex-wrap:wrap;justify-content:center">
    <input type="password" name="password" placeholder="Password"
      style="flex:1;min-width:200px;font-family:var(--f-body);font-size:15px;color:var(--espresso);background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px 15px">
    <button class="btn btn-honey" type="submit">Enter</button>
  </div>
{%- endform -%}

<p class="contact-note" style="margin-top:24px">Are you the store owner? <a href="/admin">Log in here</a>.</p>
