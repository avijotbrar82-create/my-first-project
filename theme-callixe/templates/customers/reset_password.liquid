<section class="blk" style="padding-top:70px">
  <div class="container">
    <div class="auth">
      <h1 class="pagetitle serif" style="text-align:center;margin-bottom:22px">Reset your password</h1>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="rp-pass">New password</label><input type="password" id="rp-pass" name="customer[password]" required></div>
        <div class="field"><label for="rp-conf">Confirm password</label><input type="password" id="rp-conf" name="customer[password_confirmation]" required></div>
        <button class="btn btn-honey" type="submit" style="width:100%;justify-content:center">Reset password</button>
      {%- endform -%}
    </div>
  </div>
</section>
