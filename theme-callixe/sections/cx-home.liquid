{%- liquid
  assign p1 = section.settings.dual_product_1
  assign p2 = section.settings.dual_product_2
  assign pr = section.settings.routine_product
  assign hero_img = section.settings.hero_image
-%}
<div class="cx">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  {%- if section.settings.hero_style == 'overlay' -%}
    <section class="cx-hero">
      <div class="cx-hero-media">
        {%- if hero_img != blank -%}
          <img src="{{ hero_img | image_url: width: 2000 }}" alt="{{ section.settings.hero_heading | strip_html | escape }}" width="2000" height="1200" fetchpriority="high">
        {%- else -%}
          <img src="{{ 'hero-banner.webp' | asset_url }}" alt="{{ section.settings.hero_heading | strip_html | escape }}" width="1536" height="1024" fetchpriority="high">
        {%- endif -%}
        <div class="cx-hero-veil"></div>
      </div>
      <div class="container cx-hero-inner" data-reveal>
        <h1 class="serif">{{ section.settings.hero_heading }}</h1>
        <p class="cx-hero-sub">{{ section.settings.hero_sub }}</p>
        <a class="cx-btn cx-btn-dark" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_cta }}</a>
        {%- if section.settings.hero_note != blank -%}<div class="cx-hero-note">{% render 'icon', name: 'guarantee' %} {{ section.settings.hero_note }}</div>{%- endif -%}
      </div>
    </section>
  {%- else -%}
    <section class="cx-hero-banner">
      <a class="cx-hb-wrap" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.hero_cta | default: 'Shop' | escape }}">
        {%- if hero_img != blank -%}
          <img src="{{ hero_img | image_url: width: 1800 }}" alt="{{ section.settings.hero_heading | strip_html | escape | default: 'Verta Relief' }}" width="1536" height="1024" fetchpriority="high">
        {%- else -%}
          <img src="{{ 'hero-banner.webp' | asset_url }}" alt="Verta Relief — ergonomic comfort, everyday support" width="1536" height="1024" fetchpriority="high">
        {%- endif -%}
        {%- if section.settings.hero_cta != blank -%}
          <span class="cx-hb-cta"><span class="cx-btn cx-btn-dark">{{ section.settings.hero_cta }} <span aria-hidden="true">&#8594;</span></span></span>
        {%- endif -%}
      </a>
    </section>
  {%- endif -%}

  {%- comment -%} ===== FEATURE CARDS ===== {%- endcomment -%}
  <section class="cx-band">
    <div class="container cx-feats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="cx-feat" {{ block.shopify_attributes }} data-reveal>
            <div class="cx-feat-ic">{% render 'icon', name: block.settings.icon %}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ===== FOUNDER STORY — quote · founder · story ===== {%- endcomment -%}
  <section class="cx-founder">
    <div class="container cx-founder-grid" data-reveal>

      {%- comment -%} LEFT — the relocated quote {%- endcomment -%}
      <div class="cx-founder-quote">
        {%- if section.settings.featured_label != blank -%}<div class="cx-eyebrow">{{ section.settings.featured_label }}</div>{%- endif -%}
        {%- if section.settings.quote != blank -%}<p class="cx-quote serif">{{ section.settings.quote }}</p>{%- endif -%}
      </div>

      {%- comment -%} MIDDLE — the founder portrait {%- endcomment -%}
      <figure class="cx-founder-photo">
        <span class="cx-founder-name serif">{{ section.settings.founder_name | default: 'Emma Collins' }}</span>
        <div class="cx-founder-media">
          {%- if section.settings.founder_image != blank -%}
            <img src="{{ section.settings.founder_image | image_url: width: 760 }}" alt="{{ section.settings.founder_name | default: 'Emma Collins' | escape }}, founder of Verta Relief" loading="lazy">
          {%- else -%}
            <img src="{{ 'founder-emma.webp' | asset_url }}" alt="{{ section.settings.founder_name | default: 'Emma Collins' | escape }}, founder of Verta Relief" loading="lazy">
          {%- endif -%}
          <figcaption class="cx-founder-tag">{{ section.settings.founder_tag | default: 'Founder of Verta Relief' }}</figcaption>
        </div>
      </figure>

      {%- comment -%} RIGHT — the founder story {%- endcomment -%}
      <div class="cx-founder-story">
        <div class="cx-eyebrow">Verta Relief</div>
        {%- if section.settings.story_heading != blank -%}<h2 class="serif cx-founder-h">{{ section.settings.story_heading }}</h2>{%- endif -%}
        <a class="cx-btn cx-btn-ghost cx-founder-story-btn" href="{{ section.settings.about_link | default: '/pages/about-us' }}">{{ section.settings.about_cta | default: 'Our story' }}</a>
        {%- if section.settings.story_text != blank -%}<p class="cx-founder-lead">{{ section.settings.story_text }}</p>{%- endif -%}
        {%- if section.settings.story_highlight != blank -%}<p class="cx-founder-hl">{{ section.settings.story_highlight }}</p>{%- endif -%}
        <ul class="cx-founder-benefits">
          <li>
            <span class="cx-fb-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg></span>
            <div><b>{{ section.settings.b1_title | default: 'Wind Down' }}</b><span>{{ section.settings.b1_text | default: 'Cosy warmth and gentle support to help you relax at the end of the day.' }}</span></div>
          </li>
          <li>
            <span class="cx-fb-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3a3 3 0 0 0-3 3 3 3 0 0 0-1.5 5.6A3 3 0 0 0 6 17a3 3 0 0 0 3 3 2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Z"/><path d="M15 3a3 3 0 0 1 3 3 3 3 0 0 1 1.5 5.6A3 3 0 0 1 18 17a3 3 0 0 1-3 3 2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/></svg></span>
            <div><b>{{ section.settings.b2_title | default: 'Everyday Comfort' }}</b><span>{{ section.settings.b2_text | default: 'Comfortable support that helps you stay at ease through a busy day.' }}</span></div>
          </li>
          <li>
            <span class="cx-fb-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><path d="M12 8v6m0 0-6 5m6-5 6 5m-6-5c-3 0-6-1.4-8-3m8 3c3 0 6-1.4 8-3"/></svg></span>
            <div><b>{{ section.settings.b3_title | default: 'Feel-Good Routine' }}</b><span>{{ section.settings.b3_text | default: 'A simple, calming part of your daily routine to look forward to.' }}</span></div>
          </li>
        </ul>
        {%- if section.settings.story_closing != blank -%}<p class="cx-founder-close">{{ section.settings.story_closing }}</p>{%- endif -%}
        <a class="cx-btn cx-btn-dark cx-founder-cta" href="{{ section.settings.story_cta_link | default: routes.all_products_collection_url }}">{{ section.settings.story_cta | default: 'Shop now' }}</a>
      </div>

    </div>
  </section>

  {%- comment -%} ===== HEALING STARTS AT HOME — DUAL PRODUCT CARDS ===== {%- endcomment -%}
  <section class="cx-band cx-dual-wrap">
    <div class="container">
      {%- if section.settings.dual_eyebrow != blank -%}<div class="cx-eyebrow center">{{ section.settings.dual_eyebrow }}</div>{%- endif -%}
      <h2 class="serif cx-h2 center">{{ section.settings.dual_heading }}</h2>
      <div class="cx-dual" data-reveal>
        {%- if p1 != blank -%}
          <a class="cx-dcard" href="{{ p1.url }}" style="background-image:url('{{ p1.featured_image | image_url: width: 900 }}')">
            <div class="cx-dcard-body"><h3 class="serif">{{ p1.title }}</h3><p>{{ p1.type | default: 'Comfort &amp; support' }}</p><span class="cx-btn cx-btn-light">Shop now</span></div>
          </a>
        {%- endif -%}
        {%- if p2 != blank -%}
          <a class="cx-dcard" href="{{ p2.url }}" style="background-image:url('{{ p2.featured_image | image_url: width: 900 }}')">
            <div class="cx-dcard-body"><h3 class="serif">{{ p2.title }}</h3><p>{{ p2.type | default: 'Comfort &amp; support' }}</p><span class="cx-btn cx-btn-light">Shop now</span></div>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== SHOP THE RANGE ===== {%- endcomment -%}
  {%- assign coll = collections[section.settings.collection] -%}
  <section class="cx-band">
    <div class="container">
      <h2 class="serif cx-h2">{{ section.settings.range_heading }}</h2>
      <div class="cx-range" data-reveal data-stagger>
        {%- assign src = coll.products | default: collections.all.products -%}
        {%- assign shown = 0 -%}
        {%- for product in src -%}
          {%- unless product.handle == 'professional-mini-muscle-massage-gun-with-lcd-screen' -%}
            {%- if shown < 3 -%}{% render 'cx-card', product: product %}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        <a class="cx-card cx-bundle-card" href="{{ routes.all_products_collection_url }}" data-bundle-open>
          <div class="cx-card-art cx-bundle-art">
            {%- if section.settings.bundle_image != blank -%}
              <img src="{{ section.settings.bundle_image | image_url: width: 700 }}" alt="{{ section.settings.bundle_title | escape }}">
            {%- else -%}
              <img src="{{ 'bundle-box.webp' | asset_url }}" alt="Build your Verta Relief bundle">
            {%- endif -%}
            <span class="cx-bundle-badge">Save 20%</span>
          </div>
          <div class="cx-card-body">
            <h3 class="serif">{{ section.settings.bundle_title }}</h3>
            <p class="cx-bundle-text">{{ section.settings.bundle_text }}</p>
            <span class="cx-bundle-cta">{{ section.settings.bundle_cta }} &#8594;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ===== WHAT THE REVIEWERS SAY ===== {%- endcomment -%}
  <section class="cx-band cx-experts">
    <div class="container">
      <div class="cx-eyebrow">{{ section.settings.experts_eyebrow }}</div>
      <h2 class="serif cx-h2">{{ section.settings.experts_heading }}</h2>
      <div class="cx-experts-grid" data-reveal>
        <div class="cx-expert-quote">
          <div class="cx-expert-stars">★★★★★</div>
          <blockquote class="serif">{{ section.settings.expert_quote | newline_to_br }}</blockquote>
          <div class="cx-expert-by"><b>{{ section.settings.expert_name }}</b><span>{{ section.settings.expert_title }}</span></div>
          <a class="cx-btn cx-btn-dark cx-expert-cta" href="{{ section.settings.experts_cta_link | default: routes.all_products_collection_url }}">{{ section.settings.experts_cta | default: 'Shop now' }}</a>
        </div>
        {%- assign has_expert_block = false -%}
        {%- for block in section.blocks -%}{%- if block.type == 'expert' -%}{%- assign has_expert_block = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_expert_block -%}
          <div class="cx-expert-vids">
            {%- for block in section.blocks -%}
              {%- if block.type == 'expert' -%}
                <figure class="cx-expert-vid" {{ block.shopify_attributes }}>
                  <div class="cx-expert-media">
                    {%- if block.settings.video != blank -%}
                      {{ block.settings.video | video_tag: image_size: '600x', controls: true, playsinline: true }}
                    {%- elsif block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" loading="lazy"><span class="cx-play">▶</span>
                    {%- else -%}
                      <div class="cx-ugc-ph"><span class="cx-play">▶</span><small>Video coming soon</small></div>
                    {%- endif -%}
                    <figcaption><b>{{ block.settings.name }}</b><span>{{ block.settings.credential }}</span></figcaption>
                  </div>
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="cx-expert-vids cx-expert-vids-single">
            <figure class="cx-expert-vid cx-expert-single">
              <div class="cx-expert-media">
                <video controls playsinline preload="metadata">
                  <source src="{{ 'expert-review.mp4' | asset_url }}" type="video/mp4">
                </video>
              </div>
              <figcaption class="cx-expert-cap"><b>{{ section.settings.expert_name | remove: '— ' | remove: '—' | strip }}</b><span>{{ section.settings.expert_title }}</span></figcaption>
            </figure>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 3-IN-1 ROUTINE SPLIT ===== {%- endcomment -%}
  <section class="cx-band cx-routine-wrap">
    <div class="container cx-routine">
      <div class="cx-routine-copy" data-reveal>
        <div class="cx-eyebrow">{{ section.settings.routine_eyebrow }}</div>
        <h2 class="serif cx-h2">{{ section.settings.routine_heading }}</h2>
        <p>{{ section.settings.routine_text }}</p>
        <a class="cx-btn cx-btn-dark" href="{% if pr != blank %}{{ pr.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.routine_cta }}</a>
      </div>
      <div class="cx-routine-media" data-reveal>
        {%- if section.settings.routine_image != blank -%}
          <img src="{{ section.settings.routine_image | image_url: width: 900 }}" alt="" loading="lazy">
        {%- elsif pr != blank -%}
          <img src="{{ pr.featured_image | image_url: width: 900 }}" alt="{{ pr.title | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== THE METHOD (authority slot) ===== {%- endcomment -%}
  <section class="cx-band">
    <div class="container">
      <h2 class="serif cx-h2 center">{{ section.settings.method_heading }}</h2>
      <div class="cx-method" data-reveal data-stagger>
        {%- for block in section.blocks -%}
          {%- if block.type == 'method' -%}
            <div class="cx-mstep" {{ block.shopify_attributes }}>
              <span class="cx-mnum serif">{{ block.settings.numeral }}</span>
              <h4 class="serif">{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== REVIEWS (real, from reviews.js) ===== {%- endcomment -%}
  <section class="cx-band cx-reviews">
    <div class="container">
      <div class="cx-eyebrow center">{{ section.settings.reviews_eyebrow }}</div>
      <h2 class="serif cx-h2 center">{{ section.settings.reviews_heading }}</h2>
      <div data-vr-reviews-home></div>
    </div>
  </section>


</div>

{% schema %}
{
  "name": "Callixe home",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "select", "id": "hero_style", "label": "Hero style", "default": "banner", "options": [
      { "value": "banner", "label": "Full banner image (with Shop button)" },
      { "value": "overlay", "label": "Serif text over photo" } ] },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (defaults to the 6-product banner)" },
    { "type": "html", "id": "hero_heading", "label": "Hero heading", "default": "Relief, redefined." },
    { "type": "textarea", "id": "hero_sub", "label": "Hero subtext", "default": "Considered comfort and support, made for everyday life at home." },
    { "type": "text", "id": "hero_cta", "label": "Hero button", "default": "Shop now" },
    { "type": "url", "id": "hero_link", "label": "Hero button link" },
    { "type": "text", "id": "hero_note", "label": "Hero note", "default": "30-day comfort guarantee" },
    { "type": "header", "content": "Founder story" },
    { "type": "paragraph", "content": "Row layout: quote (left) · founder photo (middle) · story (right)." },
    { "type": "text", "id": "featured_label", "label": "Quote label (left)", "default": "Made for desk workers, athletes & tired bodies" },
    { "type": "textarea", "id": "quote", "label": "Quote (left)", "default": "\"Comfortable, considered support that fits right into everyday life.\"" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder photo (middle)" },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Emma Collins" },
    { "type": "text", "id": "founder_tag", "label": "Founder tag", "default": "Founder of Verta Relief" },
    { "type": "html", "id": "story_heading", "label": "Story heading (right)", "default": "We built Verta Relief for the comfort your everyday deserves." },
    { "type": "textarea", "id": "story_text", "label": "Story intro", "default": "We felt it too: long hours at a desk, long evenings, and days that leave you wanting a little more comfort at home." },
    { "type": "text", "id": "story_highlight", "label": "Highlight line", "default": "We knew there had to be a better way." },
    { "type": "text", "id": "b1_title", "label": "Benefit 1 title", "default": "Wind Down" },
    { "type": "text", "id": "b1_text", "label": "Benefit 1 text", "default": "Cosy warmth and gentle support to help you relax at the end of the day." },
    { "type": "text", "id": "b2_title", "label": "Benefit 2 title", "default": "Everyday Comfort" },
    { "type": "text", "id": "b2_text", "label": "Benefit 2 text", "default": "Comfortable support that helps you stay at ease through a busy day." },
    { "type": "text", "id": "b3_title", "label": "Benefit 3 title", "default": "Feel-Good Routine" },
    { "type": "text", "id": "b3_text", "label": "Benefit 3 text", "default": "A simple, calming part of your daily routine you'll look forward to." },
    { "type": "textarea", "id": "story_closing", "label": "Closing line", "default": "Verta Relief isn't just another gadget. It's a considered part of your day — comfortable, dependable, and made to be used." },
    { "type": "text", "id": "about_cta", "label": "Story link button (under heading)", "default": "Our story" },
    { "type": "url", "id": "about_link", "label": "Story link button URL (About page)" },
    { "type": "text", "id": "story_cta", "label": "Shop button", "default": "Shop now" },
    { "type": "url", "id": "story_cta_link", "label": "Shop button link" },
    { "type": "header", "content": "Dual product cards" },
    { "type": "text", "id": "dual_eyebrow", "label": "Eyebrow", "default": "The essentials" },
    { "type": "text", "id": "dual_heading", "label": "Heading", "default": "Relief starts at home." },
    { "type": "product", "id": "dual_product_1", "label": "Product 1" },
    { "type": "product", "id": "dual_product_2", "label": "Product 2" },
    { "type": "header", "content": "Shop the range" },
    { "type": "text", "id": "range_heading", "label": "Heading", "default": "Shop the range" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "header", "content": "Bundle card (in range)" },
    { "type": "image_picker", "id": "bundle_image", "label": "Bundle card image" },
    { "type": "text", "id": "bundle_title", "label": "Bundle title", "default": "Build your bundle" },
    { "type": "textarea", "id": "bundle_text", "label": "Bundle text", "default": "Pick any three tools and save 20% on your comfort kit." },
    { "type": "text", "id": "bundle_cta", "label": "Bundle button", "default": "Start building" },
    { "type": "header", "content": "What the reviewers say" },
    { "type": "text", "id": "experts_eyebrow", "label": "Eyebrow", "default": "Tried & tested" },
    { "type": "text", "id": "experts_heading", "label": "Heading", "default": "An honest review" },
    { "type": "textarea", "id": "expert_quote", "label": "Reviewer quote", "default": "I've been using this for a few weeks now and honestly it's one of the comfiest things I've bought. The butterfly shape sits so nicely under my neck and the gentle warmth is lovely in the evening — it's become part of how I wind down at night.\n\nReally well made too, and comfortable enough that I actually keep reaching for it. Filmed my own little review because I liked it that much." },
    { "type": "text", "id": "expert_name", "label": "Reviewer name", "default": "— Angela S." },
    { "type": "text", "id": "expert_title", "label": "Reviewer title", "default": "Verified buyer · tried it herself" },
    { "type": "text", "id": "experts_cta", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "experts_cta_link", "label": "Button link" },
    { "type": "header", "content": "Community" },
    { "type": "text", "id": "community_eyebrow", "label": "Eyebrow", "default": "12,000+ happy customers" },
    { "type": "text", "id": "community_heading", "label": "Heading", "default": "Hear from our community" },
    { "type": "header", "content": "Routine" },
    { "type": "text", "id": "routine_eyebrow", "label": "Eyebrow", "default": "The everyday routine" },
    { "type": "text", "id": "routine_heading", "label": "Heading", "default": "Your neck & back reset" },
    { "type": "textarea", "id": "routine_text", "label": "Text", "default": "A calm 15-minute routine you can do at home — thoughtful comfort and support for the way you sit, work and unwind." },
    { "type": "text", "id": "routine_cta", "label": "Button", "default": "Shop now" },
    { "type": "product", "id": "routine_product", "label": "Routine product" },
    { "type": "image_picker", "id": "routine_image", "label": "Routine image" },
    { "type": "header", "content": "Method" },
    { "type": "text", "id": "method_heading", "label": "Heading", "default": "The Verta method" },
    { "type": "header", "content": "Reviews" },
    { "type": "text", "id": "reviews_eyebrow", "label": "Eyebrow", "default": "90-day comfort guarantee" },
    { "type": "text", "id": "reviews_heading", "label": "Heading", "default": "Join the relief journey" },
    { "type": "header", "content": "Blogs" },
    { "type": "text", "id": "blog_heading", "label": "Heading", "default": "Discover our latest journal" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "guarantee", "options": [
        {"value":"guarantee","label":"Guarantee"},{"value":"shipping","label":"Shipping"},{"value":"check","label":"Check"},{"value":"star","label":"Star"},{"value":"support","label":"Support"}] },
      { "type": "text", "id": "title", "label": "Title", "default": "Try risk-free for 30 days" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Enjoy at home and return it for a full refund if you don't love it." }
    ]},
    { "type": "logo", "name": "Featured-in logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "name", "label": "Name" }
    ]},
    { "type": "ugc", "name": "Community video", "settings": [
      { "type": "video", "id": "video", "label": "Video" },
      { "type": "image_picker", "id": "image", "label": "Image (fallback)" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "\"This has become my daily essential.\"" }
