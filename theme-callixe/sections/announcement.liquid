{%- if section.settings.enabled -%}
  {%- capture msgs -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}{{ block.settings.text }}<i>&nbsp;&nbsp;&#10022;&nbsp;&nbsp;</i>{%- endfor -%}
    {%- else -%}
      15% OFF SITEWIDE LAUNCH SALE<i>&nbsp;&nbsp;&#10022;&nbsp;&nbsp;</i>FREE SHIPPING ON EVERY ORDER<i>&nbsp;&nbsp;&#10022;&nbsp;&nbsp;</i>SIGN UP FOR YOUR 15% CODE<i>&nbsp;&nbsp;&#10022;&nbsp;&nbsp;</i>
    {%- endif -%}
  {%- endcapture -%}
  <div class="announce" role="region" aria-label="Announcements">
    <div class="track">
      <span>{{ msgs }}{{ msgs }}</span>
      <span aria-hidden="true">{{ msgs }}{{ msgs }}</span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "paragraph", "content": "Add message blocks to customise the scrolling text. With no blocks it shows the default launch messages." }
  ],
  "blocks": [
    { "type": "message", "name": "Message",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "15% OFF SITEWIDE LAUNCH SALE" } ] }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Announcement bar",
    "blocks": [
      { "type": "message", "settings": { "text": "15% OFF SITEWIDE LAUNCH SALE" } },
      { "type": "message", "settings": { "text": "FREE SHIPPING ON EVERY ORDER" } },
      { "type": "message", "settings": { "text": "SIGN UP FOR YOUR 15% CODE" } }
    ]
  }]
}
{% endschema %}
