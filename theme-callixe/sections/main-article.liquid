<article>
  <section class="pagetop">
    <div class="container" style="text-align:center;max-width:760px">
      <div class="eyebrow" data-reveal>{{ article.published_at | date: '%d %B %Y' }}</div>
      <h1 class="pagetitle serif" data-reveal style="margin-left:auto;margin-right:auto">{{ article.title }}</h1>
      {%- if article.author != blank -%}<p class="pagelead" data-reveal style="margin-left:auto;margin-right:auto">By {{ article.author }}</p>{%- endif -%}
    </div>
  </section>
  {%- if article.image -%}
    <div class="container" style="margin-top:20px"><img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="width:100%;border-radius:22px;aspect-ratio:16/9;object-fit:cover"></div>
  {%- endif -%}
  <section class="blk" style="padding-top:36px">
    <div class="container" style="display:flex;justify-content:center">
      <div class="rte" data-reveal>{{ article.content }}</div>
    </div>
  </section>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
