{%- liquid
  assign sort = collection.sort_by | default: collection.default_sort_by
-%}
<section class="cx-coll">
  <div class="container">
    <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ collection.title }}</div>
    <h1 class="cx-coll-title serif">{{ collection.title }}</h1>
    <div class="cx-coll-count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</div>
    {%- if collection.description != blank -%}<p class="cx-coll-intro">{{ collection.description }}</p>
    {%- elsif section.settings.default_intro != blank -%}<p class="cx-coll-intro">{{ section.settings.default_intro }}</p>{%- endif -%}

    <div class="cx-coll-bar">
      <div class="chips">
        <a class="chip{% unless current_tags %} active{% endunless %}" href="{{ collection.url }}">All</a>
        {%- for tag in collection.all_tags limit: 7 -%}
          <a class="chip{% if current_tags contains tag %} active{% endif %}" href="{{ collection.url }}/{{ tag | handleize }}">{{ tag | capitalize }}</a>
        {%- endfor -%}
      </div>
      <form method="get" class="sortform">
        <select class="sortsel" name="sort_by" onchange="this.form.submit()" aria-label="Sort by">
          {%- for opt in collection.sort_options -%}
            <option value="{{ opt.value }}"{% if opt.value == sort %} selected{% endif %}>Sort: {{ opt.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>
  </div>

  <div class="container">
    {%- paginate collection.products by 12 -%}
      {%- if collection.products_count > 0 -%}
        <div class="cx-range cx-coll-grid" data-reveal data-stagger>
          {%- for product in collection.products -%}{% render 'cx-card', product: product, desc: true %}{%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous">&#8592;</a>{%- else -%}<span class="disabled">&#8592;</span>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next">&#8594;</a>{%- else -%}<span class="disabled">&#8594;</span>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <h2 class="serif">Nothing here yet.</h2>
          <p>Browse the full range instead.</p>
          <p style="margin-top:18px"><a class="cx-btn cx-btn-dark" href="{{ routes.all_products_collection_url }}">Shop all recovery</a></p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "textarea", "id": "default_intro", "label": "Fallback intro (when the collection has no description)",
      "default": "Considered tools for release, decompression and better posture — free shipping and a 30-day comfort guarantee on every order." }
  ]
}
{% endschema %}
