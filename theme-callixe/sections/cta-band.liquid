<section class="ctaband">
  <div class="halo"></div>
  <div class="container" data-reveal>
    <h2 class="serif">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="cta-row">
      {%- if section.settings.button1_label != blank -%}
        <a class="btn btn-honey" href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}">{{ section.settings.button1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn-ghost" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA band",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading", "default": "Stand taller. <em>Feel lighter.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join thousands of Australians recovering gently. Free shipping on every order and a 30-day comfort guarantee." },
    { "type": "text", "id": "button1_label", "label": "Primary button", "default": "Shop recovery" },
    { "type": "url", "id": "button1_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Take the quiz" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
