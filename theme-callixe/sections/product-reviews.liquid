{%- comment -%} Renders real customer reviews for this product (data in assets/reviews.js), placed above the product. {%- endcomment -%}
<section class="blk vr-section" id="reviews" data-reveal style="padding-top:52px;padding-bottom:22px">
  <div class="container">
    <div class="vr-sechead"><h2 class="serif">{{ section.settings.heading }}</h2></div>
    <div data-vr-reviews data-handle="{{ product.handle }}"></div>
  </div>
</section>
{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers are saying" }
  ]
}
{% endschema %}
