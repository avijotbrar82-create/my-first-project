<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}<link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
  <style>
    @font-face{font-family:'Fraunces';font-weight:600;font-style:normal;src:url({{ 'fraunces-600.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Fraunces';font-weight:500;font-style:italic;src:url({{ 'fraunces-italic-500.woff2' | asset_url }}) format('woff2');}
    @font-face{font-family:'Nunito Sans';font-weight:400;font-style:normal;src:url({{ 'nunito-400.woff2' | asset_url }}) format('woff2');}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <div class="grain" aria-hidden="true"></div>
  <div class="site">
    <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:40px 20px">
      <div style="max-width:520px">
        <svg viewBox="0 0 200 200" width="64" height="64" aria-hidden="true" style="margin:0 auto 22px;display:block">
          <linearGradient id="hny" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#c58a3d"/><stop offset=".5" stop-color="#b0732e"/><stop offset="1" stop-color="#c58a3d"/></linearGradient>
          <circle cx="100" cy="100" r="94" fill="#efe7d9"/>
          <circle cx="100" cy="100" r="94" fill="none" stroke="#9c6b4e" stroke-width="1.5" stroke-opacity="0.35"/>
          <path d="M34 104 H82 L92 104 L99 90 L106 104 L114 74 L123 132 L131 104 L138 104 H166" fill="none" stroke="url(#hny)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="eyebrow" style="justify-content:center">Coming soon</div>
        <h1 class="serif" style="font-size:clamp(38px,7vw,64px);margin:14px 0 12px">{{ shop.name }}</h1>
        {{ content_for_layout }}
      </div>
    </main>
  </div>
</body>
</html>
